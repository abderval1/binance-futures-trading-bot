{
  "$schema": "https://railway.app/railway.schema.json",
  "services": [
    {
      "name": "backend",
      "type": "python",
      "path": "backend",
      "build": {
        "builder": "nixpacks"
      },
      "start": "python -m uvicorn app.main:app --host 0.0.0.0 --port $PORT",
      "env": {
        "PYTHON_VERSION": "3.11"
      }
    }
  ]
}
