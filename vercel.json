{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://seu-backend.up.railway.app/api/$1"
    }
  ],
  "env": {
    "VITE_API_URL": "https://seu-backend.up.railway.app"
  }
}
