# Production environment variables

# Database
DATABASE_URL=postgresql+psycopg2://bot_user:YOUR_PASSWORD@localhost/binance_bot

# JWT
SECRET_KEY=# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Example: 3a7f2b8c1d5e4f6a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a

# Encryption (32-byte key for AES)
ENCRYPTION_KEY=# Generate with: python -c "import os; print(os.urandom(32).hex())"
# Example: 1a2b3c4d5e6f7890abcdef1234567890abcdef1234567890abcdef1234567890

# Redis
REDIS_URL=redis://localhost:6379/0

# Binance (Master account - for admin operations)
BINANCE_API_KEY=YOUR_ADMIN_API_KEY_HERE
BINANCE_SECRET_KEY=YOUR_ADMIN_SECRET_KEY_HERE

# App config
APP_ENV=production
CORS_ORIGINS=https://yourdomain.com
