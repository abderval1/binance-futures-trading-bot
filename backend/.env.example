# Database
DATABASE_URL=postgresql+psycopg2://user:password@localhost/binance_bot

# Security
SECRET_KEY=your-secret-key-change-this-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Encryption (for API keys)
ENCRYPTION_KEY=32-character-encryption-key-here

# Redis
REDIS_URL=redis://localhost:6379/0

# Binance (Admin keys - for master account operations)
BINANCE_API_KEY=your_admin_api_key
BINANCE_SECRET_KEY=your_admin_secret_key

# Application
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
